{
    # =========================================================================
    #  CMBpipeline-pixell: training dataset on CAR cut-out maps (Task 2)
    #  Same format and, where possible, same values as ../CMBpipeline/source/config.dict
    #  (SO "rect" case). Differences are listed in docs/03_task2_dataset_plan.md.
    # =========================================================================

    # =========================================================================
    #  Sky / geometry
    # =========================================================================
    "mask_type":            "rect",       # SO-like hits mask (only case supported here)
    "nside":                512,          # HEALPix resolution of the SO mask / hits map
    "res_arcmin":           9.6,          # CAR resolution (fejer1 full sky, 1125 x 2250), matched to CMBpipeline's plane pitch
    "npixels_x":            1120,         # CAR cut-out around the SO mask: nx (RA), multiple of 32
    "npixels_y":            320,          # ny (Dec), multiple of 32

    # =========================================================================
    #  CMB signal
    # =========================================================================
    "r":                    0.034,
    "lmin":                 4,
    "lmax":                 1000,         # analysis lmax (binning), as CMBpipeline
    "lmax_sim":             1535,         # band limit of the simulated a_lm (= 3 nside - 1, CMBpipeline's synfast default)

    "cosmo_fid": {
        "H0":    67.5,
        "ombh2": 0.022,
        "omch2": 0.122,
        "tau":   0.06,
        "ns":    0.965,
        "As":    2e-9,
        "mnu":   0.06,
    },

    # =========================================================================
    #  Binning (utilities.compute_bins_fractional), as CMBpipeline
    # =========================================================================
    "binning": {
        "frac":        0.2,
        "min_width":   20,
        "extra_edges": None,
        "label":       "newbin5",
    },

    # =========================================================================
    #  Beam
    # =========================================================================
    "fwhm_arcmin":          23.0,         # applied to a_E, a_B (almxfl) when smooth = True

    # =========================================================================
    #  Noise
    # =========================================================================
    "noise_type":           "inho",
    "inho_type":            "so_hits",    # sigma^2 per CAR pixel from the SO hits map (analytic, no 2D variance file)
    "DEFAULT_NOISE_LEVEL":  5e-7,         # white-noise level [muK^2 sr] (2.43 muK-arcmin), as CMBpipeline

    # =========================================================================
    #  Rescaling factor used by the training loader (not by the dataset)
    # =========================================================================
    "map_rescale_factor": {
        "rect": 0.75068694,               # 1/std(Q_obs) of the 100 CAR validation maps (all pixels; notebooks/02_dataset_check.ipynb)
    },                                    # CMBpipeline (plane maps): 0.8382

    # =========================================================================
    #  Dataset
    # =========================================================================
    "smooth":               True,
    "apo":                  False,
    "nsims_train":          1000,
    "nsims_valid":          100,
    "nsims_test":           30,
    "cmb_seed0":            0,            # map i uses CMB seed cmb_seed0 + i (valid maps: i = nsims_train ...)
    "noise_seed0":          100000,       # map i uses noise seed noise_seed0 + i

    # =========================================================================
    #  Training (training_car.py), as CMBpipeline + curved-sky loss settings
    # =========================================================================
    "epochs":               200,
    "loss_j3":              True,         # only J3 is implemented for CAR (losses_car.CarLossJ3)
    "batch_size":           1,
    "n_trials":             10,           # Optuna trials (CMBpipeline: 10)
    "sht_lmax":             1124,         # band limit of the loss transforms (fejer1 limit at 9.6')
    "sht_method":           "cyl",        # pixell map2alm/alm2map method on the cut-out ('cyl' ~2x faster than '2d', same result for band-limited maps)
    "sht_nthread":          16,           # ducc threads for the transforms
    "fixed_params":         None,         # dict of filters0..3, lr, wd: one fixed trial instead of Optuna (short tests)
    "nuse_train":           None,         # use only the first n train / valid maps (short tests)
    "nuse_valid":           None,
    "study_name":           "carj3_nCMB_r034_beam_car9.6_cut1120x320_maskSO_inho_hitsSO",

    # =========================================================================
    #  Folders (IAS cluster, new project: nothing of CMBpipeline is overwritten)
    # =========================================================================
    "root_folder":          "/home/bcostanza/wf-curve-pixell/",       # clone of this repository
    "data_folder":          "/data/bcostanza/curve-pixell/",          # train/valid .pt
    "aux_folder":           "aux/",                                   # mask, hits, variance (CAR, with WCS), spectra, seeds
    "study_folder":         "studies/",                               # optuna sqlite .db
    "model_folder":         "optuna/models200_carj3_nCMB_r034_beam_car9.6_cut1120x320_maskSO_inho_hitsSO/",
    "loss_folder":          "optuna/losses200_carj3_nCMB_r034_beam_car9.6_cut1120x320_maskSO_inho_hitsSO/",
    "dataset_tag":          "nCMB_r034_beam_car9.6_cut1120x320_maskSO_inho_hitsSO",

    # =========================================================================
    #  Input files
    # =========================================================================
    "mask_files": {
        "so_hits": "/home/bcostanza/wf-curve/SO-like/norm_nHits_SA_35FOV_ns512.fits",   # same file (md5) as CMBpipeline's
    },
    "cmbpipeline_source":   "/home/bcostanza/wf-curve/pol/",          # CMBpipeline code on the cluster, read-only (utilities.py, projections.py: same md5 as ../CMBpipeline/source)
}
